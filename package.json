{
  "name": "vulpax-dnd",
  "version": "1.1.4",
  "description": "Masaüstü tabanlı DnD mekaniklerinden ilham alan çok oyunculu RPG",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:react\" \"npm run dev:electron\"",
    "dev:react": "vite",
    "dev:electron": "wait-on http://localhost:5173 && electron .",
    "build": "vite build && electron-builder",
    "build:win": "vite build && electron-builder --win",
    "build:mac": "vite build && electron-builder --mac",
    "release": "vite build && electron-builder --win --publish always",
    "release:mac": "vite build && electron-builder --mac --publish always",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "buffer": "^6.0.3",
    "electron-updater": "^6.8.3",
    "events": "^3.3.0",
    "framer-motion": "^10.18.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.21.0",
    "simple-peer": "^9.11.1",
    "stream-browserify": "^3.0.0",
    "util": "^0.12.5",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "vite": "^5.0.8",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.vulpax.dnd",
    "productName": "Vulpax DnD",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "assest/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist",
        "to": "app/dist",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assest/logo.png"
    },
    "mac": {
  "target": ["dmg", "zip"],
  "icon": "assest/logo.png",
  "category": "public.app-category.games"
},
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh",
      "license": "build/license.txt",
      "installerIcon": "build/logo.ico",
      "uninstallerIcon": "build/logo.ico",
      "installerHeaderIcon": "build/logo.ico",
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    },
    "publish": {
      "provider": "github",
      "owner": "EmreGocerDev",
      "repo": "VulpaxDND"
    }
  }
}
